        {
          "role": "assistant",
          "blocks": [
            {
              "type": "toolCall",
              "id": "t0",
              "name": "compute",
              "args": {
                "n00": 0,
                "n01": 1,
                "n02": -7,
                "n03": 42,
                "n04": 9007199254740991,
                "n05": 100000000000000000,
                "n06": 0.1,
                "n07": 0.2,
                "n08": 0.30000000000000004,
                "n09": 0.3333333333333333,
                "n10": 1.5,
                "n11": -0.5,
                "n12": 4503599627370495.5,
                "n13": 0.0001,
                "n14": 0.001,
                "n15": 1e-5,
                "n16": 1.5e-7,
                "n17": 1e-16,
                "n18": 2.5e-10,
                "n19": 1234567890.123,
                "n20": 12345.6789,
                "n21": 5e-324
              }
            }
          ]
        },
        { "role": "toolResult", "toolUseId": "t0", "content": [{ "type": "text", "text": "done" }] }
      ]
    },
